# ==============================================================
# DUY TRUONG MOTO - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Sao chép file này thành .env và điền các giá trị bí mật thực tế
# Tuyệt đối không commit file .env chứa thông tin bí mật lên git
# ==============================================================

# 1. CẤU HÌNH DATABASE (PostgreSQL / SQL Server / H2)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/duytruongdb
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_database_password_here

# 2. CẤU HÌNH JWT AUTHENTICATION
JWT_SECRET=your_super_secret_jwt_key_at_least_64_characters_long_for_hmac_sha256
JWT_EXPIRATION=86400000

# 3. CỔNG THANH TOÁN VNPAY SANDBOX
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret_key
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://duy-truong-moto-ecommerce.onrender.com/checkout/vnpay-return

# 4. DỊCH VỤ EMAIL SMTP (GMAIL HOẶC RESEND / BREVO)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_app_specific_password

# 5. LƯU TRỮ HÌNH ẢNH CLOUDINARY (NẾU DÙNG)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 6. WEBSOCKET & FRONTEND URL
FRONTEND_URL=https://duytruong-motor.vercel.app
VITE_API_URL=https://duy-truong-moto-ecommerce.onrender.com/api
VITE_WS_URL=wss://duy-truong-moto-ecommerce.onrender.com/ws

